<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.4/phpunit.xsd"
         colors="true"
         processIsolation="false"
         stopOnFailure="false"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         failOnDeprecation="true"
         failOnPhpunitDeprecation="true"
         failOnNotice="true"
         failOnPhpunitNotice="true"
         failOnWarning="true"
         failOnRisky="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnPhpunitDeprecations="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnPhpunitNotices="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerErrors="true">
    <php>
        <ini name="memory_limit" value="512M"/>
    </php>

    <testsuites>
        <testsuite name="DbTest Integration Suite">
            <directory>tests/Integration/</directory>
        </testsuite>
    </testsuites>

    <extensions>
        <bootstrap class="CakeDC\DbTest\Test\TestSuite\Fixture\SqliteExtension"/>
    </extensions>

    <!--
        Deprecations fail the run when the plugin triggers them or calls deprecated code of a dependency.
        Deprecations raised inside the dependencies themselves (indirect) do not.
    -->
    <source ignoreIndirectDeprecations="true">
        <include>
            <directory suffix=".php">src/</directory>
        </include>
        <deprecationTrigger>
            <function>Cake\Core\deprecationWarning</function>
            <function>deprecationWarning</function>
        </deprecationTrigger>
    </source>
</phpunit>
